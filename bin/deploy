#!/usr/bin/env bash
# Creates or updates the container app in Azure Container Apps from bin/deploy.d/containerapp.yaml.
# Help: ./bin/deploy -h (docs/deploy.md)
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"
source "$ROOT/lib/azure.sh"

BUILD=0
PULL=1
ARGS=()
while getopts ":bPh" opt; do
    case $opt in
        b) BUILD=1; ARGS+=(-b) ;;
        P) PULL=0 ;;
        h) show_help; exit 0 ;;
        *) bad_option "$OPTARG" ;;
    esac
done
shift $((OPTIND - 1))

# Pull by default; the restarted run gets -P so it doesn't pull again.
[ "$PULL" = 1 ] && pull_and_restart "${ARGS[@]}" -P

need az "see docs/azure.md"
need envsubst "sudo apt install -y gettext-base"
need jq "sudo apt install -y jq"
need curl "sudo apt install -y curl"

REVISION_SUFFIX="r$(date +%y%m%d%H%M%S)"

if [ "$BUILD" = 1 ]; then
    ACR="$ACR" IMAGE_TAG="$IMAGE_TAG" "$ROOT/bin/build" -P
    echo
fi

EXISTS=0
app_exists && EXISTS=1

# Reuse what the app already has unless told otherwise: database password, access key, and
# custom domains (with their certificates).
if [ -z "${PG_PASSWORD:-}" ] && [ "$EXISTS" = 1 ]; then
    PG_PASSWORD=$(app_secret pg-password)
fi
if [ -z "${PG_PASSWORD:-}" ]; then
    read -rsp "Database password for $PG_ADMIN: " PG_PASSWORD
    echo
fi
NEW_KEY=0
if [ -z "${API_KEY:-}" ] && [ "$EXISTS" = 1 ]; then
    API_KEY=$(app_secret api-key)
fi
if [ -z "${API_KEY:-}" ]; then
    API_KEY=$(openssl rand -hex 24)
    NEW_KEY=1
fi
CUSTOM_DOMAINS='[]'
[ "$EXISTS" = 1 ] && CUSTOM_DOMAINS=$(app_custom_domains)

echo "Checking the environment and its photo storage..."
ENV_ID=$(az containerapp env show --only-show-errors -n "$ENV" -g "$RG" --query id -o tsv)
az containerapp env storage show --only-show-errors -n "$ENV" -g "$RG" --storage-name uploads -o none

echo "Setting up the identity the app uses to pull images..."
az identity create -n "$IDENTITY" -g "$RG" -l "$LOCATION" -o none
IDENTITY_ID=$(az identity show -n "$IDENTITY" -g "$RG" --query id -o tsv)
PRINCIPAL_ID=$(az identity show -n "$IDENTITY" -g "$RG" --query principalId -o tsv)
ACR_ID=$(az acr show -n "$ACR" -g "$RG" --query id -o tsv)
if [ -z "$(az role assignment list --scope "$ACR_ID" --role AcrPull --query "[?principalId=='$PRINCIPAL_ID'].id | [0]" -o tsv)" ]; then
    az role assignment create --assignee-object-id "$PRINCIPAL_ID" --assignee-principal-type ServicePrincipal \
        --role AcrPull --scope "$ACR_ID" -o none
    echo "Waiting a minute for the registry permission to take effect..."
    sleep 60
fi

# Fill in the spec template. It ends up holding secrets, so it goes in a private temp file
# that is always removed. Only the variables listed here are substituted.
# shellcheck disable=SC2016 # the names stay literal for envsubst
SPEC_VARS='${LOCATION} ${IDENTITY_ID} ${ENV_ID} ${ACR} ${IMAGE_TAG} ${REVISION_SUFFIX} ${CUSTOM_DOMAINS} ${PG_SERVER} ${PG_ADMIN} ${PG_DATABASE} ${PG_PASSWORD} ${API_KEY}'
export LOCATION IDENTITY_ID ENV_ID ACR IMAGE_TAG REVISION_SUFFIX CUSTOM_DOMAINS PG_SERVER PG_ADMIN PG_DATABASE PG_PASSWORD API_KEY
umask 077
SPEC=$(mktemp --suffix=.yaml)
trap 'rm -f "$SPEC"' EXIT
envsubst "$SPEC_VARS" < "$ROOT/bin/deploy.d/containerapp.yaml" > "$SPEC"

if [ "$EXISTS" = 1 ]; then
    echo "Updating container app $APP (revision $REVISION_SUFFIX)..."
    az containerapp update --only-show-errors -n "$APP" -g "$RG" --yaml "$SPEC" -o none
else
    echo "Creating container app $APP..."
    az containerapp create --only-show-errors -n "$APP" -g "$RG" --yaml "$SPEC" -o none
fi

URL=$(app_url)
echo
echo "App: $URL"
if [ "$EXISTS" = 0 ]; then
    echo "The first start creates the tables and loads the starter inventory and photos (a few minutes)."
fi
echo "Watch it with: az containerapp logs show -n $APP -g $RG --container api --follow"
if [ "$NEW_KEY" = 1 ]; then
    echo
    echo "Access key for making changes (save it in your password manager; the app asks for it once per browser):"
    echo "  $API_KEY"
fi

# Wait for the new revision to run and the API to answer (it starts listening only after the
# migrations and, on the first start, the starter data).
echo
echo "Waiting for revision $REVISION_SUFFIX to start..."
REVISION="$APP--$REVISION_SUFFIX"
DEADLINE=$((SECONDS + 900))
while :; do
    STATE=$(az containerapp revision show --only-show-errors -n "$APP" -g "$RG" --revision "$REVISION" --query properties.runningState -o tsv 2>/dev/null || true)
    case $STATE in
        Running | RunningAtMaxScale) break ;;
        Failed | Degraded) die "revision $REVISION is $STATE; check the logs" ;;
    esac
    [ "$SECONDS" -lt "$DEADLINE" ] || die "revision $REVISION still isn't running (${STATE:-unknown})"
    sleep 10
done
until curl -fsS -o /dev/null "$URL/api/health" 2>/dev/null; do
    [ "$SECONDS" -lt "$DEADLINE" ] || die "the API isn't answering yet"
    sleep 10
done

echo "Revision $REVISION_SUFFIX is up."
