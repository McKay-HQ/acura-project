#!/usr/bin/env bash
# Starts the dev stack: Vite's dev server for web/ (live reload), the API, and the local database when .env enables it.
# Help: ./bin/up -h (docs/up.md)
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

while getopts ":h" opt; do
    case $opt in
        h) show_help; exit 0 ;;
        *) bad_option "$OPTARG" ;;
    esac
done
shift $((OPTIND - 1))

need docker "Docker Desktop with WSL integration, or Docker Engine with the compose plugin"
cd "$ROOT"

# The dev containers run as you (docker-compose.yml reads these), so files they write are yours.
export UID
GID=$(id -g)
export GID

# Naming vite turns on its dev profile; it brings up the API (and db, with COMPOSE_PROFILES=localdb) first.
docker compose up -d --build --wait vite

# The port is VITE_PORT, which may be set in .env, so ask compose for it.
port=$(docker compose ps vite --format '{{(index .Publishers 0).PublishedPort}}')
echo
echo "Dev stack is up: http://localhost:$port (reloads as files in web/ change)"
echo "  docker compose logs -f vite api   # logs"
echo "  ./bin/down                         # stop"
