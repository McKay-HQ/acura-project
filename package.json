{
    "name": "acura-project-tools",
    "private": true,
    "description": "Repo-wide quality tools: ESLint for api/ and web/, Prettier for everything.",
    "type": "module",
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:sarif": "eslint . --format ./tools/sarif/eslint-formatter.js --output-file eslint.sarif",
        "format": "prettier --write .",
        "check": "npm run lint && npm run typecheck",
        "typecheck": "npm run -s typecheck --prefix api && npm run -s typecheck --prefix web",
        "typecheck:sarif": "node tools/sarif/typecheck.js typecheck.sarif",
        "shellcheck:sarif": "node tools/sarif/shellcheck.js shellcheck.sarif"
    },
    "engines": {
        "node": ">=22"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/markdown": "8.0.3",
        "@html-eslint/parser": "0.66.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-parser-plain": "0.1.1",
        "eslint-plugin-prettier": "5.5.6",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2"
    }
}
