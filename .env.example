# Copy this file to .env and adjust.

# ---------------------------------------------------------------------------
# Which optional services to run. localdb is the bundled Postgres container for local dev/testing; for a managed
# database, comment this out and set DATABASE_URL below.
COMPOSE_PROFILES=localdb

# ---------------------------------------------------------------------------
# Where `docker compose push` sends the images, and their tag.
IMAGE_REGISTRY=acuraproject.azurecr.io
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Local database container (only used with the localdb profile). Above DATABASE_URL, which uses them.
POSTGRES_USER=garage
POSTGRES_PASSWORD=garage-local
POSTGRES_DB=garage
LOCAL_DB_PORT=5432

# ---------------------------------------------------------------------------
# The database. These point at the local container (localdb profile above). For a managed database, paste the
# connection string from your provider instead:
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# TLS: require (verify certificate), no-verify (encrypted, certificate not checked; some providers use self-signed
# certificates), or disable (the local container).
DATABASE_SSL=disable
# Optional: the provider's CA certificate, as PEM text or a path inside the container.
DATABASE_SSL_CA=
# Instead of DATABASE_URL you can set PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE.
# Maximum connections the API opens (keep low on small managed plans).
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Access key. Leave empty on a home network. On a public host, set a long random
# value (e.g. `openssl rand -hex 24`); the web app asks for it once per browser,
# and API clients send it as "Authorization: Bearer <key>".
API_KEY=
# Also require the key just to view the inventory.
API_KEY_FOR_READS=false

# ---------------------------------------------------------------------------
# Port the app is served on: http://localhost:8080
WEB_PORT=8080
# Port of the dev server that bin/up starts: http://localhost:5173
VITE_PORT=5173

# Where the photo folder (and the local database folder) are created on the host.
DATA_DIR=./data

# Import the starter inventory (parts, containers, tossed, to-dos, notes and photos)
# the first time the app starts against an empty database.
SEED_ON_EMPTY=true

# Largest photo accepted per file, in MB.
MAX_UPLOAD_MB=25
