#!/usr/bin/env bash
# Builds the api and web images and pushes them to the Azure Container Registry.
#
# Usage:
#   ./bin/build [-p] [-h]
#     -p  git pull first
#     -h  show this help
#
# Pushes acuraproject.azurecr.io/acura-{api,web}:latest. Set IMAGE_TAG for another tag or
# ACR for another registry. Needs az (signed in with `az login`) and docker with compose.
# ./bin/deploy -b runs this and then rolls the new images out.
set -euo pipefail

usage() { sed -n '/^# Usage:/,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; }

PULL=0
ARGS=()
while getopts ":ph" opt; do
    case $opt in
        p) PULL=1 ;;
        h) usage; exit 0 ;;
        *) echo "Unknown option -$OPTARG" >&2; usage >&2; exit 2 ;;
    esac
done
shift $((OPTIND - 1))

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [ "$PULL" = 1 ]; then
    echo "Pulling the latest code..."
    git -C "$ROOT" pull --ff-only
    # Restart so the rest of the run uses the freshly pulled version of this script.
    exec "$0" "${ARGS[@]}"
fi

cd "$ROOT"

ACR=${ACR:-acuraproject}
# Exported so they win over .env: the registry we log in to is the one we push to.
export IMAGE_REGISTRY="$ACR.azurecr.io"
export IMAGE_TAG=${IMAGE_TAG:-latest}

echo "Signing in to $IMAGE_REGISTRY..."
az acr login -n "$ACR"

echo "Building $IMAGE_REGISTRY/acura-{api,web}:$IMAGE_TAG..."
docker compose build api web

echo "Pushing..."
docker compose push api web

echo
echo "Pushed:"
echo "  $IMAGE_REGISTRY/acura-api:$IMAGE_TAG"
echo "  $IMAGE_REGISTRY/acura-web:$IMAGE_TAG"
