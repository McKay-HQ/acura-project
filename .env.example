# Copy this file to .env and adjust.

# ---------------------------------------------------------------------------
# Which compose files to use.
#   Local dev/testing (bundled Postgres container):
COMPOSE_FILE=docker-compose.yml:docker-compose.localdb.yml
#   Managed database (no local container): comment the line above out, or use
#   COMPOSE_FILE=docker-compose.yml
# (On Windows, separate the files with ; instead of :)

# ---------------------------------------------------------------------------
# Managed database (ignored while the local database file is enabled above).
# Paste the connection string from your provider:
DATABASE_URL=
# TLS: require (verify certificate), no-verify (encrypted, certificate not checked;
# some providers use self-signed certificates), or disable.
DATABASE_SSL=require
# Optional: the provider's CA certificate, as PEM text or a path inside the container.
DATABASE_SSL_CA=
# Instead of DATABASE_URL you can set PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE.
# Maximum connections the API opens (keep low on small managed plans).
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Local database container (only used with docker-compose.localdb.yml).
POSTGRES_USER=garage
POSTGRES_PASSWORD=garage-local
POSTGRES_DB=garage
LOCAL_DB_PORT=5432

# ---------------------------------------------------------------------------
# Access key. Leave empty on a home network. On a public host, set a long random
# value (e.g. `openssl rand -hex 24`); the web app asks for it once per browser,
# and API clients send it as "Authorization: Bearer <key>".
API_KEY=
# Also require the key just to view the inventory.
API_KEY_FOR_READS=false

# ---------------------------------------------------------------------------
# Port the app is served on: http://localhost:8080
WEB_PORT=8080

# Where the photo folder (and the local database folder) are created on the host.
DATA_DIR=./data

# Import the starter inventory (parts, containers, tossed, to-dos, notes and photos)
# the first time the app starts against an empty database.
SEED_ON_EMPTY=true

# Largest photo accepted per file, in MB.
MAX_UPLOAD_MB=25
