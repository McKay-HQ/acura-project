#!/usr/bin/env bash
# Replaces a part's, container's or tossed item's photos on the deployed app.
# Help: ./bin/replace-photos -h (docs/replace-photos.md)
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"
source "$ROOT/lib/azure.sh"

while getopts ":h" opt; do
    case $opt in
        h) show_help; exit 0 ;;
        *) bad_option "$OPTARG" ;;
    esac
done
shift $((OPTIND - 1))

[ $# -ge 3 ] || die "expected <parts|containers|tossed> <key-or-id> <photo>... (see $CMD -h)"
KIND=$1
REF=$2
shift 2
case $KIND in
    parts | containers | tossed) ;;
    *) die "first argument must be parts, containers or tossed (got '$KIND')" ;;
esac
for f in "$@"; do
    [ -f "$f" ] || die "no such file: $f"
done
need jq "sudo apt install -y jq"
need curl "sudo apt install -y curl"

if [ -z "${APP_URL:-}" ] || [ -z "${API_KEY:-}" ]; then
    need az "see docs/azure.md"
fi
APP_URL=${APP_URL:-$(app_url)}
API_KEY=${API_KEY:-$(app_secret api-key)}
AUTH=(-H "Authorization: Bearer $API_KEY")
BASE="$APP_URL/api/$KIND/$REF"

echo "Looking up $KIND/$REF on $APP_URL..."
OLD=$(curl -fsS "${AUTH[@]}" "$BASE" | jq -r '.photos[].id')

echo "Uploading $# photo(s)..."
FORM=()
for f in "$@"; do FORM+=(-F "photos=@$f"); done
curl -fsS "${AUTH[@]}" "${FORM[@]}" "$BASE/photos" -o /dev/null

if [ -n "$OLD" ]; then
    echo "Deleting $(echo "$OLD" | wc -l) old photo(s)..."
    for id in $OLD; do
        curl -fsS -X DELETE "${AUTH[@]}" "$APP_URL/api/photos/$id" -o /dev/null
    done
fi

echo "Done. $KIND/$REF now has:"
curl -fsS "${AUTH[@]}" "$BASE" | jq -r '.photos[] | "  \(.url)"'
