# Rendered at container start by the nginx image: ${API_URL} is replaced from the
# environment (default http://api:3000 for Docker Compose; http://localhost:3000 when
# both containers share a Container App). nginx's own $variables are left alone.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Phone photos can be large; the API re-encodes them after upload.
    client_max_body_size 100m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass ${API_URL};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    location /uploads/ {
        proxy_pass ${API_URL};
        expires 30d;
    }

    # Hashed build assets never change, so cache them for a long time.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
