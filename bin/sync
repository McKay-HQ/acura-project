#!/usr/bin/env bash
# Two-way sync between the catalog (api/seed/) and the live app, through the app's API.
# Help: ./bin/sync -h (docs/sync.md)
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"
source "$ROOT/lib/azure.sh"

PULL=1
DRY_RUN=0
COMMIT=1
PREFER=""
ARGS=()
while getopts ":dCcaPh" opt; do
    case $opt in
        d) DRY_RUN=1; ARGS+=(-d) ;;
        C) COMMIT=0; ARGS+=(-C) ;;
        c) [ "$PREFER" = app ] && die "-c and -a can't be used together"; PREFER=catalog; ARGS+=(-c) ;;
        a) [ "$PREFER" = catalog ] && die "-c and -a can't be used together"; PREFER=app; ARGS+=(-a) ;;
        P) PULL=0 ;;
        h) show_help; exit 0 ;;
        *) bad_option "$OPTARG" ;;
    esac
done
shift $((OPTIND - 1))

# Pull by default; the restarted run gets -P so it doesn't pull again.
[ "$PULL" = 1 ] && pull_and_restart "${ARGS[@]}" -P

need python3 "sudo apt install -y python3"
if [ -z "${APP_URL:-}" ] || [ -z "${API_KEY:-}" ]; then
    need az "see docs/azure.md"
fi
APP_URL=${APP_URL:-$(app_url)}
API_KEY=${API_KEY:-$(app_secret api-key)}

# Commit api/seed on a new sync/ branch, push it, and open a pull request into main that merges by
# itself: auto-merge when the repo allows it, otherwise merged right away. Without gh, print the link.
# The commit goes on top of origin/main and holds only what the sync changed in api/seed, whatever
# branch is checked out: the pull request is labeled sync and merges unreviewed, so it can't carry code.
share_catalog() {
    local stamp branch title url index main synced tree commit
    stamp=$(date '+%Y-%m-%d %H:%M')
    branch="sync/catalog-$(date '+%Y%m%d-%H%M%S')"
    title="chore(sync): catalog from the app ($stamp)"
    echo "Sharing the updated catalog on $branch..."
    git -C "$ROOT" fetch -q origin main
    main=$(git -C "$ROOT" rev-parse FETCH_HEAD)
    # Build the commit in a scratch index, so the checked-out branch and its index aren't touched.
    index=$(mktemp)
    # The sync's changes: api/seed as it is now, against HEAD...
    GIT_INDEX_FILE=$index git -C "$ROOT" read-tree HEAD
    GIT_INDEX_FILE=$index git -C "$ROOT" add -A -- api/seed
    synced=$(GIT_INDEX_FILE=$index git -C "$ROOT" write-tree)
    # ...applied to origin/main.
    GIT_INDEX_FILE=$index git -C "$ROOT" read-tree "$main"
    if ! git -C "$ROOT" diff --binary HEAD "$synced" -- api/seed | GIT_INDEX_FILE=$index git -C "$ROOT" apply --cached; then
        rm -f "$index"
        die "the catalog changes don't apply to origin/main; bring this branch up to date with main and run again"
    fi
    tree=$(GIT_INDEX_FILE=$index git -C "$ROOT" write-tree)
    rm -f "$index"
    commit=$(git -C "$ROOT" commit-tree "$tree" -p "$main" -m "$title")
    git -C "$ROOT" push -q origin "$commit:refs/heads/$branch"
    # Leave the current branch as it was; the catalog reaches it with the next git pull once merged.
    git -C "$ROOT" restore --source=HEAD --staged --worktree -- api/seed
    git -C "$ROOT" clean -fdq -- api/seed
    if ! command -v gh >/dev/null || ! gh auth status >/dev/null 2>&1; then
        echo "Open a pull request for $branch to get it into main (gh isn't set up to do it)."
        return
    fi
    url=$(cd "$ROOT" && gh pr create --base main --head "$branch" --title "$title" --label sync \
        --body "Changes made in the app, pulled into the catalog by \`bin/sync\`.")
    echo "Pull request: $url"
    # A pull request opened by a workflow's own token doesn't start other workflows, so start the
    # checks by hand; required checks then report on it like on any other pull request.
    if [ -n "${GITHUB_ACTIONS:-}" ]; then
        for workflow in static-checks.yml build-checks.yml; do
            (cd "$ROOT" && gh workflow run "$workflow" --ref "$branch" >/dev/null 2>&1) || true
        done
        (cd "$ROOT" && gh workflow run labels.yml --ref "$branch" >/dev/null 2>&1) || true
    fi
    if (cd "$ROOT" && gh pr merge "$url" --auto --squash --delete-branch >/dev/null 2>&1); then
        echo "It merges by itself once its checks pass."
    elif (cd "$ROOT" && gh pr merge "$url" --squash --delete-branch); then
        echo "Merged."
    else
        echo "Couldn't merge it yet; merge it on GitHub once its checks pass."
    fi
}

STATUS=0
APP_URL="$APP_URL" API_KEY="$API_KEY" ROOT="$ROOT" DRY_RUN="$DRY_RUN" PREFER="$PREFER" python3 -I "$ROOT/bin/sync.d/sync.py" || STATUS=$?
[ "$STATUS" = 1 ] && exit 1

# Share what was pulled from the app (catalog, photos, sync state) so the artifact can pick it up.
# main only takes changes through pull requests, so the catalog goes on a branch with a pull request
# that merges itself (or as soon as required checks pass).
if [ "$DRY_RUN" = 0 ] && [ "$COMMIT" = 1 ] && [ -n "$(git -C "$ROOT" status --porcelain -- api/seed)" ]; then
    share_catalog
fi
exit "$STATUS"
