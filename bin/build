#!/usr/bin/env bash
# Builds the api and web images and pushes them to the Azure Container Registry.
#
# Usage:
#   ./bin/build                      # acuraproject.azurecr.io/acura-{api,web}:latest
#   IMAGE_TAG=2026-10-13 ./bin/build # a different tag
#   ACR=otherregistry ./bin/build    # a different registry
#
# Needs: az (signed in with `az login`) and docker with the compose plugin.
# After pushing, ./bin/deploy.sh (first time) or a new revision picks up the images:
#   az containerapp update -n acura -g acura-project --revision-suffix "r$(date +%Y%m%d%H%M)"
set -euo pipefail

cd "$(dirname "$0")/.."

ACR=${ACR:-acuraproject}
# Exported so they win over .env: the registry we log in to is the one we push to.
export IMAGE_REGISTRY="$ACR.azurecr.io"
export IMAGE_TAG=${IMAGE_TAG:-latest}

echo "Signing in to $IMAGE_REGISTRY..."
az acr login -n "$ACR"

echo "Building $IMAGE_REGISTRY/acura-{api,web}:$IMAGE_TAG..."
docker compose build api web

echo "Pushing..."
docker compose push api web

echo
echo "Pushed:"
echo "  $IMAGE_REGISTRY/acura-api:$IMAGE_TAG"
echo "  $IMAGE_REGISTRY/acura-web:$IMAGE_TAG"
