#!/usr/bin/env bash
# Two-way sync between the catalog (api/seed/) and the live app, through the app's API.
# Help: ./bin/sync -h (docs/sync.md)
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"
source "$ROOT/lib/azure.sh"

PULL=1
DRY_RUN=0
COMMIT=1
PREFER=""
ARGS=()
while getopts ":dCcaPh" opt; do
    case $opt in
        d) DRY_RUN=1; ARGS+=(-d) ;;
        C) COMMIT=0; ARGS+=(-C) ;;
        c) [ "$PREFER" = app ] && die "-c and -a can't be used together"; PREFER=catalog; ARGS+=(-c) ;;
        a) [ "$PREFER" = catalog ] && die "-c and -a can't be used together"; PREFER=app; ARGS+=(-a) ;;
        P) PULL=0 ;;
        h) show_help; exit 0 ;;
        *) bad_option "$OPTARG" ;;
    esac
done
shift $((OPTIND - 1))

# Pull by default; the restarted run gets -P so it doesn't pull again.
[ "$PULL" = 1 ] && pull_and_restart "${ARGS[@]}" -P

need python3 "sudo apt install -y python3"
if [ -z "${APP_URL:-}" ] || [ -z "${API_KEY:-}" ]; then
    need az "see docs/azure.md"
fi
APP_URL=${APP_URL:-$(app_url)}
API_KEY=${API_KEY:-$(app_secret api-key)}

STATUS=0
APP_URL="$APP_URL" API_KEY="$API_KEY" ROOT="$ROOT" DRY_RUN="$DRY_RUN" PREFER="$PREFER" python3 -I "$ROOT/bin/sync.d/sync.py" || STATUS=$?
[ "$STATUS" = 1 ] && exit 1

# Share what was pulled from the app (catalog, photos, sync state) so the artifact can pick it up.
if [ "$DRY_RUN" = 0 ] && [ "$COMMIT" = 1 ] && [ -n "$(git -C "$ROOT" status --porcelain -- api/seed)" ]; then
    echo "Committing the updated catalog..."
    git -C "$ROOT" add api/seed
    git -C "$ROOT" commit -q -m "sync: catalog from the app ($(date '+%Y-%m-%d %H:%M'))"
    git -C "$ROOT" push -q
fi
exit "$STATUS"
